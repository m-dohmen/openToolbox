# Umgebungsspezifische Werte für .multica/setup.sh.
#
# Kopieren nach .multica/.env — die ist über .gitignore ausgeschlossen und
# gehört nicht ins Repository. Hier stehen keine Geheimnisse: die Anmeldung
# macht `multica login`, das Token liegt in der CLI-Konfiguration. Was hier
# steht, ist Topologie — welcher Workspace, welche Maschine.

# Name der Runtime, auf der die Agenten laufen. Pflicht.
# Verfügbare Namen zeigt: multica runtime list
export MULTICA_RUNTIME="Claude (mein-server.example)"

# Abweichender Workspace-Slug (Standard: opentoolbox)
# export MULTICA_WORKSPACE_SLUG="opentoolbox"

# Abweichendes Modell (Standard: claude-sonnet-5)
# export MULTICA_MODEL="claude-sonnet-5"
